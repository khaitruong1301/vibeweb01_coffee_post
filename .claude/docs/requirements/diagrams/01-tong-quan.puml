@startuml 01-tong-quan
title CoffeePOS — Sơ đồ use case tổng quan
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F5EBDD
  BorderColor #6F4E37
}

actor "Nhân viên" as NV
actor "Thu ngân" as TN
actor "Pha chế" as PC
actor "Chủ quán\n(admin)" as CQ
actor "GrabFood /\nShopeeFood" as APP <<hệ thống ngoài>>

TN -up-|> NV
PC -up-|> NV
CQ -up-|> NV

rectangle "CoffeePOS" {
  usecase "UC01\nĐăng nhập" as UC01
  usecase "UC02\nBán hàng tại quầy\n(tạo đơn & thanh toán)" as UC02
  usecase "UC03\nIn hóa đơn CP-…" as UC03
  usecase "UC04\nNhận đơn giao đồ ăn" as UC04
  usecase "UC05\nNhận đơn ở màn quầy pha" as UC05
  usecase "UC06\nQuản lý sản phẩm\n(thêm món, sửa giá)" as UC06
}

NV --> UC01
TN --> UC02
TN --> UC03
TN --> UC04
PC --> UC05
CQ --> UC06
UC04 -- APP

UC02 ..> UC01 : <<include>>
UC04 ..> UC01 : <<include>>
UC05 ..> UC01 : <<include>>
UC06 ..> UC01 : <<include>>
UC03 .> UC02 : <<extend>>
@enduml
