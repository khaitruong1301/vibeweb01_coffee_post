                </mxCell>
                <mxCell id="c37" value="Các lý do 400:&lt;br&gt;• items rỗng (BR03)&lt;br&gt;• qty &amp;lt; 1, &amp;gt; 50, không phải số nguyên (BR02)&lt;br&gt;• product_id không tồn tại / ngừng bán&lt;br&gt;• size không thuộc S/M/L" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontSize=12;align=left;" vertex="1" parent="1">
