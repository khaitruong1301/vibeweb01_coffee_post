                </mxCell>
                <mxCell id="c118" value="Lưu" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;rounded=1;arcSize=15;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="800" y="758" width="116" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="c119" value="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;ellipse;fillColor=#E53935;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="630" y="354" width="26" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c120" value="2" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;ellipse;fillColor=#E53935;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="354" width="26" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c121" value="3" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;ellipse;fillColor=#E53935;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="466" width="26" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c122" value="4" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;ellipse;fillColor=#E53935;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="748" width="26" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c123" value="&lt;b&gt;1 Giá bán&lt;/b&gt; — bắt buộc, số nguyên &amp;gt; 0, có thể đặt mức trần (vd ≤ 1.000.000đ) để chặn gõ thừa số 0. Hiện giá cũ và mức chênh để chủ quán kiểm lại.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Giá size L&lt;/b&gt; — chỉ đọc, = giá bán + 6.000đ (BR05). Đổi luật phụ thu chỉ sửa một chỗ trên server.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Xem thử tính tiền&lt;/b&gt; — trả lời câu hỏi “sửa giá xong làm sao biết không tính sai?” ngay trên màn hình; công thức phải giống hệt hàm tính tiền trên server. Bảo đảm thật sự vẫn là &lt;b&gt;test tự động&lt;/b&gt; chạy trong CI.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Lưu&lt;/b&gt; — chỉ admin (403 với vai khác). Lưu xong: toast “Đã cập nhật giá”, ghi người sửa + thời điểm.&lt;br&gt;&lt;br&gt;“Thêm món” dùng cùng form, các ô để trống." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;shape=note;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="1330" y="70" width="400" height="520" as="geometry"/>
                </mxCell>
            </root>
