                <mxCell id="c38" value="Giữ nguyên giỏ, tô đỏ dòng món lỗi để thu ngân sửa." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontSize=11;align=left;fontColor=#555555;" vertex="1" parent="1">
