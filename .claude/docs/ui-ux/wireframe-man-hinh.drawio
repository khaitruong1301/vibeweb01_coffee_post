                <mxCell id="c113" value="☑ Đang bán" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontSize=12;align=left;" vertex="1" parent="1">
                    <mxGeometry x="671" y="436" width="245" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c114" value="&lt;b&gt;Xem thử tính tiền&lt;/b&gt;&lt;br&gt;1 ly size M = 32.000đ&lt;br&gt;2 ly size L = 2 × (32.000 + 6.000) = &lt;b&gt;76.000đ&lt;/b&gt;&lt;br&gt;50 ly size M = &lt;b&gt;1.600.000đ&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color:#777&#39;&gt;Áp dụng cho đơn tạo sau khi lưu; đơn cũ giữ giá cũ.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;rounded=0;fillColor=#F2F2F2;strokeColor=#BBBBBB;fontSize=12;rounded=1;arcSize=5;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
                    <mxGeometry x="404" y="474" width="512" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="c115" value="Nhập sai (để trống, ≤ 0, số lẻ, chữ) → ô viền đỏ + “Giá phải là số nguyên lớn hơn 0”, khóa nút Lưu" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontSize=11;align=left;fontColor=#777777;" vertex="1" parent="1">
