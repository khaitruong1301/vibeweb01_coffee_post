                </mxCell>
                <mxCell id="c72" value="&lt;b&gt;1 Tự làm mới&lt;/b&gt; — gọi GET danh sách đơn định kỳ; đơn mới (từ UC02/UC04) xuất hiện ở cột Chờ pha kèm âm báo.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 Thẻ đơn&lt;/b&gt; — mã CP-…, giờ tạo, nguồn (mã đơn đối tác nếu có), từng món: SL × tên (size). Đơn cũ nhất ở trên cùng (cao điểm 7h–9h).&lt;br&gt;&lt;br&gt;&lt;b&gt;3 Ghi chú&lt;/b&gt; — ghi chú của thu ngân nổi bật màu cam.&lt;br&gt;&lt;br&gt;&lt;b&gt;4 Chuyển trạng thái&lt;/b&gt; — Chờ pha → Đang pha → Xong → Đã giao (ẩn khỏi màn). &lt;i&gt;(giả định — đề chỉ nói “nhận đơn ở màn quầy pha”)&lt;/i&gt;&lt;br&gt;&lt;br&gt;Pha chế không thấy giá tiền, không sửa được đơn." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;shape=note;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="1330" y="70" width="400" height="470" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
