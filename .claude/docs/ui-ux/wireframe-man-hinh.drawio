                <mxCell id="c131" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;ellipse;fillColor=#E53935;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" value="6" vertex="1">
                    <mxGeometry height="26" width="26" x="950" y="106" as="geometry"/>
