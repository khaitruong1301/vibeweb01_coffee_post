                <mxCell id="c109" value="Giá cũ: 29.000đ · tăng 3.000đ" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontSize=11;align=left;fontColor=#B26A00;" vertex="1" parent="1">
