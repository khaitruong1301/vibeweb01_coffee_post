                <mxCell id="c111" value="38.000" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;rounded=0;fillColor=#F2F2F2;strokeColor=#BBBBBB;fontSize=12;rounded=1;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
