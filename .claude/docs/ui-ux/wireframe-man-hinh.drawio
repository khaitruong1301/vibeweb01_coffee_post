                </mxCell>
                <mxCell id="c36" value="⚠ &lt;b&gt;Đơn không hợp lệ&lt;/b&gt;&lt;br&gt;Món “Bạc xỉu” đã ngừng bán" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;rounded=1;arcSize=10;fillColor=#FDECEA;strokeColor=#E53935;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
