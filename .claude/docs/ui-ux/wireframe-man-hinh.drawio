                <mxCell id="c112" value="☑ Có chọn size (S / M / L)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontSize=12;align=left;" vertex="1" parent="1">
                    <mxGeometry x="404" y="436" width="300" height="22" as="geometry"/>
