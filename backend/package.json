{
  "name": "coffeepos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API CoffeePOS — NestJS 11 + Prisma 7 + PostgreSQL 17",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:all": "npm test && npm run test:e2e",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed/run.ts",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "test:cov": "jest --coverage --json --outputFile=reports/jest-unit.json",
    "test:e2e:cov": "jest --config test/jest-e2e.json --runInBand --coverage --json --outputFile=reports/jest-e2e.json",
    "test:regression": "jest -t \"BR0|L1|L2|L3\" && jest --config test/jest-e2e.json --runInBand -t \"BR0|L1|L2|L3\"",
    "test:ci": "jest --coverage --ci && jest --config test/jest-e2e.json --runInBand --coverage --ci",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.16.0",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.73.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "pricing/**/*.ts",
      "orders/order-*.ts",
      "common/**/*.ts",
      "auth/login-limiter.ts",
      "!**/*.spec.ts",
      "!common/swagger.ts",
      "!common/dto/**",
      "!common/id.pipe.ts"
    ],
    "coverageDirectory": "../coverage/unit",
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 95,
        "branches": 85,
        "functions": 95,
        "statements": 95
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit-unit.xml",
          "suiteNameTemplate": "{filepath}",
          "classNameTemplate": "{classname}",
          "titleTemplate": "{title}",
          "ancestorSeparator": " › ",
          "addFileAttribute": "true"
        }
      ]
    ]
  },
  "overrides": {
    "effect": "3.22.5",
    "@nestjs/cli": {
      "glob": "^14.0.6"
    }
  }
}
