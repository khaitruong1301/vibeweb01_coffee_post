# Sao chép thành backend/.env khi chạy local (npm run dev). Không commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/coffeepos"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5435/coffeepos_test"
JWT_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"
PORT=4100
# URL frontend được phép gọi API kèm cookie (dev chạy Next ngoài proxy)
CORS_ORIGIN="http://localhost:3100"
APP_ENV=development
# Giới hạn đăng nhập sai (mặc định 5 / tài khoản, 20 / IP trong 900 giây)
LOGIN_MAX_FAILS_PER_USER=5
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_WINDOW_SEC=900
