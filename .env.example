# Biến cho docker compose — sao chép thành .env (không commit .env)
JWT_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"
DB_PASSWORD="postgres"
# Nạp dữ liệu mẫu khi DB còn trống (true/false)
SEED=true
# production: APP_ENV=production → API từ chối khởi động nếu JWT_SECRET yếu / mặc định, và SEED=true bắt buộc SEED_PASSWORD
APP_ENV=development
# Mật khẩu cho các tài khoản seed (bỏ trống ở dev = Coffee@123). BẮT BUỘC trên production nếu SEED=true
SEED_PASSWORD=
# true khi web chạy HTTPS: cookie Secure + HSTS
COOKIE_SECURE=false
# Swagger /api/docs: mặc định bật ở dev, tắt ở production (đặt true để bật)
SWAGGER_ENABLED=
DB_PORT=5435
BACKEND_PORT=4100
FRONTEND_PORT=3100
# Địa chỉ mở cổng DB / API trên máy chủ — production đặt 127.0.0.1 (chỉ web ra Internet)
DB_BIND=0.0.0.0
BACKEND_BIND=0.0.0.0
# Origin được phép gọi API trực tiếp kèm cookie
CORS_ORIGIN="http://localhost:3100"
